---
interface Props {
  date: string;
  role: string;
  company?: string;
  description: string;
  tags?: string[];
}

const { date, role, company, description, tags = [] } = Astro.props;
---

<div class="relative pl-5 sm:pl-8 group">
  <div class="absolute left-[5px] top-2 bottom-[-1.5rem] w-[2px] bg-border/50"></div>

  <div class="absolute left-[0px] top-[7px] w-3 h-3 rounded-full bg-primary ring-4 ring-background"></div>

  <div class="font-mono text-[11px] sm:text-sm text-secondary/80 font-medium tracking-tight pt-0.5 select-none mb-2 sm:mb-3">
    {date}
  </div>

  <div class="space-y-2 sm:space-y-2.5 pb-4">
    <div class="flex flex-wrap items-baseline gap-x-2">
      <h3 class="text-[15px] sm:text-lg font-semibold text-primary tracking-tight">
        {role}
      </h3>
      {company && (
        <span class="text-[13px] sm:text-sm font-normal text-secondary">
          <span class="text-secondary/40 mr-1.5">•</span>{company}
        </span>
      )}
    </div>

    <p class="text-[13px] sm:text-[15px] text-secondary leading-relaxed">
      {description}
    </p>

    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 pt-1">
        {tags.map((tag) => (
          <span class="text-[10px] sm:text-[11px] font-mono text-secondary/90 px-1.5 sm:px-2 py-0.5 rounded border border-border/60 bg-surface/60">
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>
</div>

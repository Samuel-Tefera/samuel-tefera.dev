---
import { Icon } from 'astro-icon/components';
---

<footer class="bg-background py-8 border-t border-border">
  <div class="container mx-auto px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-secondary text-sm">
    <div>
      &copy; 2026 Samuel Tefera
    </div>
    <div class="flex items-center gap-6">
      <a href="https://github.com/Samuel-Tefera" class="hover:text-primary transition-colors" aria-label="GitHub">
        <Icon name="simple-icons:github" class="w-4 h-4" />
      </a>
      <a href="https://www.linkedin.com/in/samueltefera" class="hover:text-primary transition-colors" aria-label="LinkedIn">
        <Icon name="simple-icons:linkedin" class="w-4 h-4" />
      </a>
      <a href="https://x.com/samutef" class="hover:text-primary transition-colors" aria-label="X (Twitter)">
        <Icon name="simple-icons:x" class="w-4 h-4" />
      </a>
      <a href="https://t.me/samuelTefera7" class="hover:text-primary transition-colors" aria-label="Telegram">
        <Icon name="simple-icons:telegram" class="w-4 h-4" />
      </a>
    </div>
  </div>
</footer>

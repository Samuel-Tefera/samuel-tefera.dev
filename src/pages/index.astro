---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import ProjectCard from '../components/ProjectCard.astro';
import WorkItem from '../components/WorkItem.astro';
---

<Layout>
  <main class="min-h-screen bg-background text-primary flex items-center">
    <div class="container mx-auto px-6 lg:px-8 py-24">
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-primary">
          Samuel Tefera
        </h1>

        <h2 class="text-lg sm:text-xl font-medium text-secondary mb-10 text-balance">
          Software engineer building practical software for businesses — from lean websites to AI-driven automation.
        </h2>

        <div class="space-y-6 text-base sm:text-base text-secondary leading-relaxed text-balance mb-12">
          <p>
            Currently building <strong class="font-medium text-primary">Ranko Metrics</strong>, a free SEO rank tracking tool for solo founders.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-6 text-secondary">
          <a href="#" class="hover:text-primary transition-colors" aria-label="GitHub">
            <Icon name="simple-icons:github" class="w-6 h-6" />
          </a>
          <a href="#" class="hover:text-primary transition-colors" aria-label="LinkedIn">
            <Icon name="simple-icons:linkedin" class="w-6 h-6" />
          </a>
          <a href="#" class="hover:text-primary transition-colors" aria-label="X (Twitter)">
            <Icon name="simple-icons:x" class="w-6 h-6" />
          </a>
          <a href="#" class="hover:text-primary transition-colors" aria-label="Telegram">
            <Icon name="simple-icons:telegram" class="w-6 h-6" />
          </a>
        </div>
      </div>
    </div>
  </main>

  <!-- Selected Works -->
  <section id="projects" class="bg-background pt-8 pb-24 lg:pt-24 lg:pb-32">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mb-20 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-primary">
          Selected Work
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 max-w-7xl mx-auto">
        <ProjectCard
          title="Lensey"
          year="2025"
          description="Business intelligence for SMEs that tracks sales and expenses and surfaces AI-driven insights for decision-making."
          tags={[
            { icon: "simple-icons:python", label: "Python" },
            { icon: "simple-icons:nextdotjs", label: "Next.js" },
          ]}
          liveUrl="#"
          codeUrl="#"
        />

        <ProjectCard
          title="PolicyWatch-ET"
          year="2025"
          description="Scrapes Ethiopian government policy and uses AI to summarize it, making legal and regulatory changes easier to track."
          tags={[
            { icon: "simple-icons:python", label: "Python" },
            { icon: "simple-icons:astro", label: "Astro" },
          ]}
          liveUrl="#"
          codeUrl="#"
        />

        <ProjectCard
          title="Easy-Study"
          year="2024"
          description="AI study tool that turns uploaded PDFs into plain-language explanations, examples, and analogies to save students time."
          tags={[
            { icon: "simple-icons:python", label: "Python" },
            { icon: "simple-icons:react", label: "React" },
            { icon: "simple-icons:typescript", label: "TypeScript" },
          ]}
          liveUrl="#"
          codeUrl="#"
        />

        <ProjectCard
          title="Class Coordinator Bot"
          year="2024"
          description="Automates the daily coordination work of a university class representative, right inside Telegram."
          tags={[
            { icon: "simple-icons:python", label: "Python" },
            { icon: "simple-icons:telegram", label: "Telegram API" },
          ]}
          liveUrl="#"
          codeUrl="#"
        />
      </div>
    </div>
  </section>

  <!-- Work -->
  <section id="work" class="bg-background py-16 lg:py-24">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="mb-20 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-primary">
          Work
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-16 max-w-7xl mx-auto">
        <WorkItem
          date="Sept 2026 — Present"
          role="Software Engineering Intern"
          company="EagleLion System Technology"
          description="Started as a software engineering intern, contributing to real-world engineering projects across the internship term."
          tags={["Python", "Next.js", "TypeScript"]}
        />

        <WorkItem
          date="2025 — Present"
          role="Backend Engineer & DevOps"
          company="WCUTS"
          description="Design and build backend systems — REST and GraphQL APIs, database design, and deployment pipelines. Also mentor WCU tech students on engineering practices."
          tags={["Python", "TypeScript", "Docker", "Git", "Linux"]}
        />

        <WorkItem
          date="2023 — Present"
          role="B.Sc. Software Engineering"
          company="Wachemo University"
          description="Studying software engineering, with a focus on systems design and practical application development."
        />

        <WorkItem
          date="2024"
          role="AI & Career Essentials"
          company="ALX"
          description="Completed a program covering applied AI and career-readiness skills for the tech industry."
        />
      </div>
    </div>
  </section>
</Layout>
